[Unit]
Description=Vmoto/Carbit: stavová stránka na ethernetu (port 80)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
Environment=WEB_BIND=0.0.0.0
Environment=WEB_PORT=80
Environment=VMOTO_DIR=/opt/vmoto-carbit-cam
ExecStart=/usr/bin/python3 -u /opt/vmoto-carbit-cam/web.py
# /run/vmoto: živé nastavení výřezu/datového toku pro logger (přežije restart stránky, ne restart Pi)
RuntimeDirectory=vmoto
RuntimeDirectoryPreserve=yes
# dokud síť nemá adresu, bind selže -> zkusit znovu
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
